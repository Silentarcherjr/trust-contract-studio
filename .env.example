# Trust Contract Studio — environment variables. Copy to .env for local dev.
# Never commit .env. All values below are placeholders.

# --- Database -------------------------------------------------------------
# Local development uses in-process PGlite (WASM Postgres). Production and any
# shared deployment must use a hosted PostgreSQL URL instead.
DATABASE_URL=pglite:./data/pglite
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------
# Skip login for LOCAL DEV ONLY. Never set on a deployed instance.
# AUTH_DISABLED=true
# Production deployments need a stable random secret (>= 32 chars).
# BETTER_AUTH_SECRET=

# --- Proof receipts -------------------------------------------------------
# HMAC key for receipt integrity (>= 32 chars). Without it a per-process
# random key is used and receipts only verify until the server restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RECEIPT_SIGNING_KEY=

# --- Agent LLM (optional for the deterministic demo) -----------------------
# The Studio's planner, executor and verifier run without an LLM. The in-app
# agent chat needs one of: Builder.io connection (in-app), or a provider key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- External agents over MCP (local development only) ---------------------
# A static bearer token for MCP hosts, and the single local workspace it acts
# as. Hosted deployments use the framework's MCP OAuth instead.
# ACCESS_TOKEN=
# AGENT_NATIVE_OWNER_EMAIL=dev@local.test

# --- Containers without IPv6 ----------------------------------------------
# DEV_HOST=127.0.0.1
# DEV_PORT=8080

# Health check message
PING_MESSAGE=pong

# Optional: live provider check against Dodo Payments TEST MODE (pnpm demo:dodo).
# Use a test-mode key only (dodo_test_...); the adapter refuses live keys.
# DODO_PAYMENTS_API_KEY=
# A test customer with a saved test card, and a recurring test product:
# DODO_TEST_PRODUCT_ID=
# DODO_TEST_CUSTOMER_ID=
# DODO_TEST_PAYMENT_METHOD_ID=
